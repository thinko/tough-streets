// Package dhcp provides a DHCP server implementation
package dhcp

import (
	"bytes"
	"errors"
	"net"
	"time"

	"github.com/cenkalti/backoff/v4"
	"github.com/krolaw/dhcp4"

	"tough-streets/internal/config"
	"tough-streets/internal/logger"
	"tough-streets/internal/metrics"
	"tough-streets/internal/resilience"
	"tough-streets/internal/server/models"
	"tough-streets/internal/server/storage"
)

var (
	ErrInvalidConfig = errors.New("invalid configuration")
	ErrNoIPAvailable = errors.New("no IP addresses available")
)

// Server represents the DHCP service
type Server struct {
	config config.DHCPConfig
	db     storage.DataAccessLayer
	log    *logger.Logger
	ipPool *IPPool
}

// IPPool manages available IP addresses and leases
type IPPool struct {
	startIP   net.IP
	endIP     net.IP
	leases    map[string]*Lease // MAC -> Lease
	available []net.IP
	db        storage.DataAccessLayer
	log       *logger.Logger
}

// Lease represents a DHCP lease
type Lease struct {
	IP        net.IP
	MAC       net.HardwareAddr
	ExpiresAt time.Time
}

// dhcpHandler handles DHCP requests
type dhcpHandler struct {
	config config.DHCPConfig
	db     storage.DataAccessLayer
	ipPool *IPPool
	log    *logger.Logger
}

// NewServer creates a new DHCP server instance
func NewServer(cfg config.DHCPConfig, db storage.DataAccessLayer) (*Server, error) {
	log := logger.GetLogger().WithField("component", "dhcp_server")

	startIP := net.ParseIP(cfg.IPRangeStart)
	endIP := net.ParseIP(cfg.IPRangeEnd)
	if startIP == nil || endIP == nil {
		log.Error("Invalid IP range configuration")
		return nil, ErrInvalidConfig
	}

	ipPool := &IPPool{
		startIP:   startIP,
		endIP:     endIP,
		leases:    make(map[string]*Lease),
		available: generateIPRange(startIP, endIP),
		db:        db,
		log:       log.WithField("subcomponent", "ip_pool"),
	}

	server := &Server{
		config: cfg,
		db:     db,
		log:    log,
		ipPool: ipPool,
	}

	return server, nil
}

// Start begins listening for DHCP requests
func (s *Server) Start() error {
	s.log.WithFields(logger.Fields{
		"interface":     s.config.Interface,
		"ip_range":      s.config.IPRangeStart + "-" + s.config.IPRangeEnd,
		"lease_time":    s.config.LeaseTime,
		"domain":        s.config.DomainName,
		"router":        s.config.Router,
		"dns_servers":   s.config.DNSServers,
	}).Info("Starting DHCP server")

	metrics.DHCPOperations.WithLabelValues("server", "start").Inc()

	handler := &dhcpHandler{
		config:  s.config,
		db:      s.db,
		ipPool:  s.ipPool,
		log:     s.log.WithField("subcomponent", "request_handler"),
	}

	// Start the periodic lease cleanup
	go s.runLeaseCleanup()

	// Wrap the DHCP service with circuit breaker resilience
	cb := resilience.NewCircuitBreaker(
		resilience.CircuitBreakerConfig{
			Name:             "dhcp_server",
			FailureThreshold: 0.3,
			MinimumRequests:  10,
			Interval:         time.Minute,
			Timeout:          time.Minute * 2,
			SuccessThreshold: 3,
		},
	)

	// Try to start the DHCP server with retry logic on failures
	retryOptions := resilience.RetryOptions{
		MaxRetries:      3,
		InitialInterval: 1 * time.Second,
		MaxInterval:     5 * time.Second,
		Multiplier:      2.0,
		MaxElapsedTime:  30 * time.Second,
	}

	err := resilience.WithCircuitBreakerAndRetry(
		context.Background(),
		cb,
		retryOptions,
		func() error {
			// ListenAndServeIf requires root privileges
			if err := dhcp4.ListenAndServeIf(s.config.Interface, handler); err != nil {
				s.log.WithError(err).Error("DHCP server failed to start")
				metrics.DHCPOperations.WithLabelValues("server", "error").Inc()
				return err
			}
			return nil
		},
	)

	if err != nil {
		s.log.WithError(err).Error("DHCP server failed to start after retries")
		return err
	}

	return nil
}

// Stop gracefully shuts down the DHCP server
func (s *Server) Stop() error {
	s.log.Info("Stopping DHCP server")
	metrics.DHCPOperations.WithLabelValues("server", "stop").Inc()
	// TODO: Implement proper shutdown
	return nil
}

// ServeDHCP handles incoming DHCP requests
func (h *dhcpHandler) ServeDHCP(p dhcp4.Packet, msgType dhcp4.MessageType, options dhcp4.Options) dhcp4.Packet {
	startTime := time.Now()
	defer func() {
		metrics.DHCPLatency.WithLabelValues("request").Observe(time.Since(startTime).Seconds())
	}()

	macAddr := p.CHAddr()
	log := h.log.WithFields(logger.Fields{
		"mac_addr":     macAddr.String(),
		"message_type": msgType.String(),
	})

	log.Debug("Processing DHCP request")
	metrics.DHCPOperations.WithLabelValues("request", msgType.String()).Inc()

	// Try to get device info with exponential backoff
	var device *models.Device
	operation := func() error {
		var err error
		device, err = h.db.GetDeviceByMAC(macAddr.String())
		if err != nil && err != storage.ErrNotFound {
			log.WithError(err).Error("Failed to query device")
			metrics.DHCPOperations.WithLabelValues("database", "error").Inc()
			return err
		}
		return nil // Continue even if device not found
	}

	backoffConfig := backoff.NewExponentialBackOff()
	backoffConfig.MaxElapsedTime = 2 * time.Second

	if err := backoff.Retry(operation, backoffConfig); err != nil {
		log.WithError(err).Error("Failed to query device after retries")
		return nil
	}

	// Check for existing reservation
	if device != nil && device.DHCPReservationIP != "" {
		reservedIP := net.ParseIP(device.DHCPReservationIP)
		if reservedIP != nil {
			metrics.DHCPOperations.WithLabelValues("reservation", "found").Inc()
			log.WithField("reserved_ip", reservedIP.String()).Debug("Found reservation")
			return h.handleReservation(p, msgType, options, reservedIP, macAddr)
		}
	}

	switch msgType {
	case dhcp4.Discover:
		return h.handleDiscover(p, options, macAddr, log)
	case dhcp4.Request:
		return h.handleRequest(p, options, macAddr, log)
	case dhcp4.Release:
		h.handleRelease(p, options, macAddr, log)
		return nil
	default:
		log.WithField("type", msgType.String()).Debug("Ignoring unhandled message type")
		metrics.DHCPOperations.WithLabelValues("message", "ignored").Inc()
		return nil
	}
}

func (h *dhcpHandler) handleDiscover(p dhcp4.Packet, options dhcp4.Options, macAddr net.HardwareAddr, log *logger.Logger) dhcp4.Packet {
	startTime := time.Now()
	defer func() {
		metrics.DHCPLatency.WithLabelValues("discover").Observe(time.Since(startTime).Seconds())
	}()

	// Get an available IP
	ip := h.ipPool.GetAvailableIP(macAddr)
	if ip == nil {
		log.Error("No available IPs for DISCOVER")
		metrics.DHCPOperations.WithLabelValues("discover", "no_ip").Inc()
		return nil
	}

	log.WithField("offer_ip", ip.String()).Info("Offering IP address")
	metrics.DHCPOperations.WithLabelValues("discover", "offer").Inc()

	// Convert dhcp4.Options to []dhcp4.Option format
	opts := []dhcp4.Option{}
	
	// Add DNS servers
	if len(h.config.DNSServers) > 0 {
		dnsIPs := make([]byte, 0, len(h.config.DNSServers)*4)
		for _, server := range h.config.DNSServers {
			dnsIPs = append(dnsIPs, net.ParseIP(server).To4()...)
		}
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainNameServer,
			Value: dnsIPs,
		})
	}
	
	// Domain name
	if h.config.DomainName != "" {
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainName,
			Value: []byte(h.config.DomainName),
		})
	}
	
	// Router
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionRouter,
		Value: net.ParseIP(h.config.Router).To4(),
	})
	
	// Subnet mask (assuming /24 for simplicity)
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionSubnetMask,
		Value: []byte{255, 255, 255, 0},
	})
	
	return dhcp4.ReplyPacket(
		p,
		dhcp4.Offer,
		net.ParseIP(h.config.Router),
		ip,
		time.Duration(h.config.LeaseTime)*time.Second,
		opts)
}

func (h *dhcpHandler) handleRequest(p dhcp4.Packet, options dhcp4.Options, macAddr net.HardwareAddr, log *logger.Logger) dhcp4.Packet {
	startTime := time.Now()
	defer func() {
		metrics.DHCPLatency.WithLabelValues("request").Observe(time.Since(startTime).Seconds())
	}()

	requestedIP := net.IP(options[dhcp4.OptionRequestedIPAddress])
	if requestedIP == nil {
		requestedIP = net.IP(p.CIAddr())
	}

	if !h.ipPool.IsIPAvailable(requestedIP, macAddr) {
		log.WithField("requested_ip", requestedIP.String()).Warn("Requested IP not available")
		metrics.DHCPOperations.WithLabelValues("request", "denied").Inc()
		return dhcp4.ReplyPacket(p, dhcp4.NAK, net.ParseIP(h.config.Router), nil, 0, nil)
	}

	lease := &Lease{
		IP:        requestedIP,
		MAC:       macAddr,
		ExpiresAt: time.Now().Add(time.Duration(h.config.LeaseTime) * time.Second),
	}

	if err := h.ipPool.AssignLease(lease); err != nil {
		log.WithError(err).Error("Failed to assign lease")
		metrics.DHCPOperations.WithLabelValues("request", "error").Inc()
		return dhcp4.ReplyPacket(p, dhcp4.NAK, net.ParseIP(h.config.Router), nil, 0, nil)
	}

	log.WithFields(logger.Fields{
		"ip":        requestedIP.String(),
		"lease_end": lease.ExpiresAt,
	}).Info("IP address assigned")

	metrics.DHCPOperations.WithLabelValues("request", "ack").Inc()
	metrics.ActiveLeases.Inc()

	// Convert dhcp4.Options to []dhcp4.Option format
	opts := []dhcp4.Option{}
	
	// Add DNS servers
	if len(h.config.DNSServers) > 0 {
		dnsIPs := make([]byte, 0, len(h.config.DNSServers)*4)
		for _, server := range h.config.DNSServers {
			dnsIPs = append(dnsIPs, net.ParseIP(server).To4()...)
		}
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainNameServer,
			Value: dnsIPs,
		})
	}
	
	// Domain name
	if h.config.DomainName != "" {
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainName,
			Value: []byte(h.config.DomainName),
		})
	}
	
	// Router
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionRouter,
		Value: net.ParseIP(h.config.Router).To4(),
	})
	
	// Subnet mask (assuming /24 for simplicity)
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionSubnetMask,
		Value: []byte{255, 255, 255, 0},
	})
	
	return dhcp4.ReplyPacket(
		p,
		dhcp4.ACK,
		net.ParseIP(h.config.Router),
		requestedIP,
		time.Duration(h.config.LeaseTime)*time.Second,
		opts)
}

func (h *dhcpHandler) handleRelease(p dhcp4.Packet, options dhcp4.Options, macAddr net.HardwareAddr, log *logger.Logger) {
	startTime := time.Now()
	defer func() {
		metrics.DHCPLatency.WithLabelValues("release").Observe(time.Since(startTime).Seconds())
	}()

	releasedIP := net.IP(p.CIAddr())
	if releasedIP != nil && h.ipPool.ReleaseLease(macAddr) {
		log.WithField("ip", releasedIP.String()).Info("IP address released")
		metrics.DHCPOperations.WithLabelValues("release", "success").Inc()
		metrics.ActiveLeases.Dec()
	}
}

func (h *dhcpHandler) handleReservation(p dhcp4.Packet, msgType dhcp4.MessageType, options dhcp4.Options, reservedIP net.IP, macAddr net.HardwareAddr) dhcp4.Packet {
	// Convert dhcp4.Options to []dhcp4.Option format
	opts := []dhcp4.Option{}
	
	// Add DNS servers
	if len(h.config.DNSServers) > 0 {
		dnsIPs := make([]byte, 0, len(h.config.DNSServers)*4)
		for _, server := range h.config.DNSServers {
			dnsIPs = append(dnsIPs, net.ParseIP(server).To4()...)
		}
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainNameServer,
			Value: dnsIPs,
		})
	}
	
	// Domain name
	if h.config.DomainName != "" {
		opts = append(opts, dhcp4.Option{
			Code:  dhcp4.OptionDomainName,
			Value: []byte(h.config.DomainName),
		})
	}
	
	// Router
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionRouter,
		Value: net.ParseIP(h.config.Router).To4(),
	})
	
	// Subnet mask (assuming /24 for simplicity)
	opts = append(opts, dhcp4.Option{
		Code:  dhcp4.OptionSubnetMask,
		Value: []byte{255, 255, 255, 0},
	})
	
	switch msgType {
	case dhcp4.Discover:
		return dhcp4.ReplyPacket(p, dhcp4.Offer, net.ParseIP(h.config.Router), reservedIP,
			time.Duration(h.config.LeaseTime)*time.Second, opts)
	case dhcp4.Request:
		requestedIP := net.IP(options[dhcp4.OptionRequestedIPAddress])
		if requestedIP == nil {
			requestedIP = net.IP(p.CIAddr())
		}
		if !requestedIP.Equal(reservedIP) {
			return dhcp4.ReplyPacket(p, dhcp4.NAK, net.ParseIP(h.config.Router), nil, 0, nil)
		}
		return dhcp4.ReplyPacket(p, dhcp4.ACK, net.ParseIP(h.config.Router), reservedIP,
			time.Duration(h.config.LeaseTime)*time.Second, opts)
	}
	return nil
}

// Helper functions for IPPool

func (p *IPPool) GetAvailableIP(mac net.HardwareAddr) net.IP {
	p.log.WithField("mac", mac.String()).Debug("Looking for available IP")

	// First check for an existing lease
	if lease := p.leases[mac.String()]; lease != nil && time.Now().Before(lease.ExpiresAt) {
		return lease.IP
	}

	// Then try to get a new IP from the pool
	for _, ip := range p.available {
		inUse := false
		for _, lease := range p.leases {
			if lease.IP.Equal(ip) && time.Now().Before(lease.ExpiresAt) {
				inUse = true
				break
			}
		}
		if !inUse {
			return ip
		}
	}

	return nil
}

func (p *IPPool) IsIPAvailable(ip net.IP, mac net.HardwareAddr) bool {
	// Check if IP is in our range
	if !isIPInRange(ip, p.startIP, p.endIP) {
		return false
	}

	// Check existing leases
	for macStr, lease := range p.leases {
		if lease.IP.Equal(ip) {
			// IP is leased to someone else and hasn't expired
			if macStr != mac.String() && time.Now().Before(lease.ExpiresAt) {
				return false
			}
			// IP is leased to this MAC or the lease has expired
			return true
		}
	}

	// IP is not leased
	return true
}

func (p *IPPool) AssignLease(lease *Lease) error {
	p.leases[lease.MAC.String()] = lease

	// Update device in database
	device := &models.Device{
		PrimaryMAC: lease.MAC.String(),
		IPAddresses: []models.IPAddress{{
			Address:     lease.IP.String(),
			FirstSeen:   time.Now(),
			LastSeen:    time.Now(),
			IsDHCPLease: true,
			Source:      "dhcp",
		}},
	}

	if err := p.db.UpdateDevice(device); err != nil {
		p.log.WithError(err).Error("Failed to update device lease")
		metrics.DHCPOperations.WithLabelValues("database", "error").Inc()
		return err
	}

	return nil
}

func (p *IPPool) ReleaseLease(mac net.HardwareAddr) bool {
	if lease, exists := p.leases[mac.String()]; exists {
		delete(p.leases, mac.String())
		p.log.WithFields(logger.Fields{
			"mac": mac.String(),
			"ip":  lease.IP.String(),
		}).Info("Lease released")
		return true
	}
	return false
}

// Cleanup runs lease cleanup in a separate goroutine
func (s *Server) runLeaseCleanup() {
	ticker := time.NewTicker(5 * time.Minute)
	defer ticker.Stop()

	for {
		<-ticker.C
		s.log.Debug("Running lease cleanup")
		now := time.Now()

		count := 0
		for mac, lease := range s.ipPool.leases {
			if now.After(lease.ExpiresAt) {
				s.log.WithFields(logger.Fields{
					"mac": mac,
					"ip":  lease.IP.String(),
				}).Debug("Removing expired lease")
				delete(s.ipPool.leases, mac)
				count++
			}
		}

		if count > 0 {
			metrics.ActiveLeases.Sub(float64(count))
		}
	}
}

func generateIPRange(start, end net.IP) []net.IP {
	var ips []net.IP
	for ip := start; !ip.Equal(end); ip = incrementIP(ip) {
		newIP := make(net.IP, len(ip))
		copy(newIP, ip)
		ips = append(ips, newIP)
	}
	ips = append(ips, end)
	return ips
}

func incrementIP(ip net.IP) net.IP {
	newIP := make(net.IP, len(ip))
	copy(newIP, ip)
	for i := len(newIP) - 1; i >= 0; i-- {
		newIP[i]++
		if newIP[i] > 0 {
			break
		}
	}
	return newIP
}

func isIPInRange(ip, start, end net.IP) bool {
	return bytes.Compare(ip, start) >= 0 && bytes.Compare(ip, end) <= 0
}
